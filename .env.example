# Context Memory Fabric Configuration Template
#
# One template for both ways of running CMF -- copy it to .env:
#   cp .env.example .env
#
# - Docker preview (docker-compose.preview.yml): pick your model providers
#   and set their API keys (see "Model providers" below; the defaults use a
#   Gemini key), then go. The defaults below point at the bundled fictional
#   starter-wiki and an isolated "CMF-local" graph on non-conflicting host
#   ports. Inside the container, compose overrides FALKORDB_HOST/PORT,
#   LLM_WIKI_PATH (mounted at /wiki) and CMF_STATE_DIR itself. The preview
#   always mounts a wiki, so it can't run without one.
# - Bare-metal / full setup (docs/SETUP.md): also point FALKORDB_DATABASE at
#   your own graph, and LLM_WIKI_PATH at your own corpus or leave it empty.

# Path to your durable knowledge corpus: a folder of Markdown notes, such as
# an Obsidian vault (OPTIONAL). Leave it empty to run without a wiki: the
# wiki tools (search_wiki, propose_doc_update, ...) are then not offered and
# extraction proposes episodes only. For a bare-metal run use an absolute
# path -- a relative one resolves against whatever directory the MCP client
# launches the server from.
LLM_WIKI_PATH=./starter-wiki

# Model API keys. Each one is needed only when a provider setting below
# (CMF_LLM_PROVIDER, CMF_EMBED_PROVIDER, CMF_CAPTURE_LLM_PROVIDER) names that
# provider; the defaults use gemini. Fill in the ones you use and leave the
# rest as they are. Local models need no key. See "Model providers" below
# for which provider can do which job.
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# FalkorDB connection settings (OPTIONAL, defaults to localhost:6379)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_PASSWORD=

# Encryption key for the FalkorDB Browser's session/credential storage
# (OPTIONAL for the MCP server itself, but required by docker-compose.yml
# to keep the bundled Browser UI's sessions valid across container
# restarts). Must be exactly 64 hex characters (32 bytes). Generate with:
#   openssl rand -hex 32
ENCRYPTION_KEY=

# Target FalkorDB graph database name (OPTIONAL). If unset, falls back to
# the "default_db" sandbox rather than a real production graph, so a
# client with no explicit config can't silently read or write production
# data (see server/providers/memory_graphiti.py).
FALKORDB_DATABASE=CMF-local

# Proposals staging directory (OPTIONAL, defaults to ./wiki-proposals)
# CMF_STATE_DIR=

# ---------------------------------------------------------------------------
# Docker preview host ports (docker-compose.preview.yml only)
# ---------------------------------------------------------------------------
# Change these if the ports are already in use on your machine. The MCP
# endpoint is then http://localhost:${CMF_MCP_PORT}/mcp.
PREVIEW_FALKORDB_PORT=6380
PREVIEW_BROWSER_PORT=3002
CMF_MCP_PORT=8000

# Shared-secret bearer token required by the streamable-http/sse network
# transports (irrelevant to stdio, which is trusted by process ownership
# alone). Unset = those transports run unauthenticated -- fine for a
# 127.0.0.1-only local run, not for anything exposed further (a VPN
# Funnel, a tunnel, etc.) -- see docs/CLIENTS.md. Generate with:
#   openssl rand -hex 32
# Mutually exclusive with CMF_MCP_ISSUER_URL below -- if both are set,
# OAuth wins and this is ignored (with a startup warning).
# CMF_MCP_AUTH_TOKEN=

# OAuth 2.1 support -- what Claude Desktop's, ChatGPT's, and
# Gemini's own connector UIs actually expect (Dynamic Client Registration +
# authorization-code + PKCE), unlike CMF_MCP_AUTH_TOKEN above, which none of
# their GUIs have a field for. Must be set TOGETHER, or both left unset --
# see docs/CLIENTS.md.
#   CMF_MCP_ISSUER_URL: must exactly match wherever this server is publicly
#     reachable (e.g. your VPN Funnel hostname). Every client
#     validates this against the server's own metadata, so a mismatch
#     breaks the flow, not just a formality.
#   CMF_MCP_OAUTH_PASSWORD: the actual security boundary. Both /register
#     and /authorize are unauthenticated by spec (any client can reach the
#     consent page) -- this password is what a human has to know to
#     actually approve a new client and get it a working access token.
# CMF_MCP_ISSUER_URL=
# CMF_MCP_OAUTH_PASSWORD=

# Gemini free-tier rate limiter (OPTIONAL). CMF never places a
# Gemini call that would exceed the free tier's per-model RPM/RPD ceiling
# for models listed here, and falls through to the next model in the
# chain once one is exhausted rather than blocking outright. Ceilings
# themselves are read from server/core/rate_limiter.py's
# KNOWN_MODEL_BUDGETS, not from these env vars — re-verify those numbers
# against your own AI Studio rate-limit dashboard periodically; Google
# does not publish them anywhere static.
# CMF_GEMINI_MODEL_CHAIN=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# CMF_GEMINI_CALLS_PER_OPERATION=3

# ---------------------------------------------------------------------------
# Model providers and local inference
# ---------------------------------------------------------------------------
# Provider switches, split so extraction and embeddings can come from
# different places. Which provider can do which job:
#
#   provider    LLM (extraction)   embeddings   needs
#   anthropic   yes                no           ANTHROPIC_API_KEY
#   openai      yes                yes          OPENAI_API_KEY
#   gemini      yes                yes          GEMINI_API_KEY (free tier works)
#   local       yes                yes          an OpenAI-compatible server:
#                                               LM Studio, Ollama or vLLM
#
# Anthropic has no embeddings API, so pair it with an openai, gemini or
# local embedder. Common setups: anthropic + openai; openai + openai;
# gemini + gemini (free); any LLM + a local Ollama embedder (docs/SETUP.md).
# CMF_LLM_PROVIDER and CMF_CAPTURE_LLM_PROVIDER take any of the four;
# CMF_EMBED_PROVIDER takes openai, gemini or local. An unrecognised value
# raises at startup rather than silently falling back — a typo here would
# otherwise send traffic to a metered API you believed you had switched
# away from.
CMF_LLM_PROVIDER=gemini
CMF_EMBED_PROVIDER=gemini

# Hosted-API settings (keys are at the top of this file). The SDKs retry
# rate limits themselves.
# Claude model. claude-opus-5-5 is the step up, claude-haiku-5-5 costs less.
# CMF_ANTHROPIC_MODEL=claude-sonnet-5-5
# Claude effort: low, medium, high, xhigh or max. Unset = the model's default.
# CMF_ANTHROPIC_EFFORT=low
# CMF_OPENAI_MODEL=gpt-5.5
# OpenAI embeddings are shortened to EMBEDDING_DIM (1024 by default).
# CMF_OPENAI_EMBED_MODEL=text-embedding-3-small

# The LLM the background capture pollers extract with (Claude Code, Cowork,
# Codex, Antigravity). They run unattended, and one long transcript is dozens
# of extraction calls, so they don't follow CMF_LLM_PROVIDER: unset = local.
# Set it to anthropic, openai or gemini to let the pollers spend that
# provider's quota.
# CMF_CAPTURE_LLM_PROVIDER=local

# LM Studio on the DGX Spark, reached over the Tailscale-backed SSH tunnel:
#   ssh -N -L 12345:127.0.0.1:1234 spark
# Never point this at the Spark's public address — LM Studio's API is
# unauthenticated and the host has no firewall under our control.
# Unset = http://127.0.0.1:12345/v1 bare-metal (server/core/config.py), and
# http://host.docker.internal:12345/v1 in the Docker preview -- leave these
# commented unless your endpoint differs, or the container will try to
# reach 127.0.0.1 inside itself.
# CMF_LOCAL_BASE_URL=http://127.0.0.1:12345/v1
# CMF_LOCAL_API_KEY=lm-studio
# Separate endpoints when the local LLM and embedder run on different
# servers; each falls back to CMF_LOCAL_BASE_URL / CMF_LOCAL_API_KEY.
# CMF_LOCAL_LLM_BASE_URL=
# CMF_LOCAL_LLM_API_KEY=
# CMF_LOCAL_EMBED_BASE_URL=
# CMF_LOCAL_EMBED_API_KEY=
# Local extraction model. GLM-4.7-Flash was measured well below Gemini
# (pronoun entities, self-loops, paraphrase-spam, one hallucination);
# qwen3.5-122b-a10b + the EXTRACTION_INSTRUCTIONS nudge in memory_graphiti.py
# matches Gemini on hygiene and closes to ~5 pts on recall.
CMF_LOCAL_LLM_MODEL=unsloth/qwen3.5-122b-a10b
CMF_LOCAL_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# Example: a small local embedder via Ollama (docs/SETUP.md, "Run a Small
# Local Embedder"), runs on a laptop CPU. Pairs with any LLM provider. Pick
# this before the graph has data; EMBEDDING_DIM is fixed per graph.
#   ollama pull nomic-embed-text
# CMF_EMBED_PROVIDER=local
# CMF_LOCAL_EMBED_BASE_URL=http://127.0.0.1:11434/v1
# CMF_LOCAL_EMBED_API_KEY=ollama
# CMF_LOCAL_EMBED_MODEL=nomic-embed-text
# EMBEDDING_DIM=768

# How structured output is requested from LM Studio.
#   json_object -> graphiti puts the schema in the prompt; the client proxy
#                  rewrites the wire format to "text". Works on GLM-4.7-Flash,
#                  Qwen3.5-35B-A3B and Gemma-4-26B-A4B.
#   json_schema -> constrained decoding. GLM and Qwen strand the answer in
#                  reasoning_content; Gemma corrupts via a control-token leak.
CMF_LOCAL_STRUCTURED_MODE=json_schema

# Embedding width. MUST match the embedder's real output:
#   gemini-embedding-001         -> 1024 (requested)
#   nomic-embed-text-v1.5        ->  768 (fixed; cannot be widened)
# Changing this is not reversible in place — a graph's vectors and its index
# are built at one width. Change it only together with FALKORDB_DATABASE,
# pointing at a fresh graph. Read before graphiti_core is imported, via
# server/__init__.py.
EMBEDDING_DIM=1024

# ---------------------------------------------------------------------------
# Entity extraction
# ---------------------------------------------------------------------------
# Entity extraction prompt used on every remember()/correction: coverage-
# first, 10-type ontology, one project entity per episode. Unset = typed-recall;
# "legacy" (the pre-2026-09-28 prompt) is only for reproducing old extraction.
CMF_EXTRACTION_PROFILE=typed-recall
# Delete debris-shaped entities (paths, identifiers, numbers, local labels)
# that only the new episode mentions. Off unless set.
# CMF_ENTITY_DEBRIS_FILTER=1
# Embed each new episode's text for recall_mem's episode-vector arm.
# CMF_EMBED_EPISODES=1

# ---------------------------------------------------------------------------
# Knowledge providers
# ---------------------------------------------------------------------------
# Comma-separated module:Class list queried by search_knowledge and
# get_context. Default: the LLM_Wiki provider only. Adding Gmail puts
# sent-mail excerpts into get_context for EVERY connected client.
# CMF_KNOWLEDGE_PROVIDERS=server.providers.wiki.provider:FileKnowledgeProvider,server.providers.gmail.provider:GmailKnowledgeProvider
# Gmail reads a local snapshot (CMF holds no Gmail credentials); fill it
# with scripts/import_gmail_mbox.py from a Google Takeout mbox.
# CMF_GMAIL_SNAPSHOT_DIR=imports/gmail/snapshot
# CMF_GMAIL_ACCOUNT=me@example.com

# Claude Cowork adapter. Scheduled tasks run without a selected folder, so
# their project comes from this task-id -> project map (comma-separated).
# CMF_COWORK_SCHEDULED_TASK_PROJECTS=my-weekly-task=my-project,my-sweep-task=other-project

# Names from your own work that the entity-extraction prompt shows the model
# as examples, so it recognises your projects, hardware and topics as entities
# (comma-separated). Examples only: the model still extracts names not listed
# here. Kept in .env so personal names stay out of tracked files. Unset = generic
# built-ins. Each uses only its first few names: 5 workstreams, 4 hardware,
# 6 topics, 1 person, 3 debris files. Read at server start.
# CMF_EXTRACTION_WORKSTREAMS=Project Atlas,home-lab,Acme Billing
# CMF_EXTRACTION_HARDWARE=Mac mini,NAS,Raspberry Pi
# CMF_EXTRACTION_TOPICS=vector search,woodworking
# A person you work with, shown as the example of a Person entity.
# CMF_EXTRACTION_PERSON=Sam Rivera
# File names from your work, shown as examples of what NOT to extract.
# CMF_EXTRACTION_DEBRIS_FILES=train_model.py,results.json,app.js

# Folders whose children are projects (comma-separated; ~ expands). A session
# in ~/code/my-app is project "my-app". Unset = the macOS layout only:
# /Users/<you>/Dev, /Users/<you>/Documents and /Volumes/<drive>/projects, so
# on Linux or Windows set it. Setting it replaces those defaults.
# CMF_PROJECT_ROOTS=~/code,~/work
# Folder -> project, longest prefix wins (comma-separated path=project; ~ expands).
# Applied before CMF_PROJECT_ROOTS, by the Claude Code, Codex and Cowork adapters.
# CMF_PROJECT_FOLDER_MAP=~/Dev/my-repo/data=my-data-project
# Fold one project slug into another (comma-separated old=new).
# CMF_PROJECT_ALIASES=old-slug=new-slug

# Name recorded on review verdicts when the reviewing client names no one.
# Unset = your OS login name.
# CMF_REVIEWER=your-name

# Your own review rules (a Markdown file outside the repo), appended to the
# generic rules the nightly review follows (docs/NIGHTLY-REVIEW.md), e.g.
# which wiki folder a topic belongs in, or what is always an episode.
# CMF_REVIEW_RULES_PATH=~/cmf-review-rules.md
