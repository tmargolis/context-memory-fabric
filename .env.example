# Context Memory Fabric Configuration Template

# Path to your local durable knowledge corpus directory (REQUIRED)
LLM_WIKI_PATH=/path/to/your/LLM_Wiki

# Google Gemini API key for Graphiti LLM extraction and embeddings (REQUIRED)
GEMINI_API_KEY=your_gemini_api_key_here

# FalkorDB connection settings (OPTIONAL, defaults to localhost:6379)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_PASSWORD=

# Target FalkorDB graph database name (REQUIRED, no default).
# Context Memory Fabric refuses to guess a graph name so that a
# misconfigured deployment cannot silently read or write the wrong
# episodic graph.
FALKORDB_DATABASE=memory-fabric

# Proposals staging directory (OPTIONAL, defaults to ./wiki-proposals)
# CMF_STATE_DIR=
