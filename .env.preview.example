# Context Memory Fabric (CMF) - Preview Environment Configuration Template
# Copy this file to .env before starting the preview container:
#   cp .env.preview.example .env

# ==============================================================================
# 1. Model Provider Configuration (REQUIRED)
# ==============================================================================
# Set your Google Gemini API key for extraction and embeddings:
GEMINI_API_KEY=your_gemini_api_key_here

# Provider switches ("gemini" or "local"):
CMF_LLM_PROVIDER=gemini
CMF_EMBED_PROVIDER=gemini

# Embedding dimensions (1024 for Gemini gemini-embedding-001; 768 for nomic local embedder)
EMBEDDING_DIM=1024

# ==============================================================================
# 2. Knowledge Corpus (Durable Knowledge)
# ==============================================================================
# Path to your Markdown wiki or Obsidian vault.
# By default, points to the included fictional starter wiki:
LLM_WIKI_PATH=./starter-wiki

# ==============================================================================
# 3. FalkorDB Graph Settings
# ==============================================================================
# Target graph name within FalkorDB:
FALKORDB_DATABASE=preview_db

# Host port mappings (if running on a machine with ports already in use):
PREVIEW_FALKORDB_PORT=6380
PREVIEW_BROWSER_PORT=3002
CMF_MCP_PORT=8000

# ==============================================================================
# 4. Optional Security & Transport
# ==============================================================================
# Optional bearer token for MCP HTTP endpoint. If left empty, the local endpoint
# accepts connections from localhost without authentication.
# CMF_MCP_AUTH_TOKEN=
